# Warehouse SyncServer — конфигурация помощника кладовщика.
# Скопируйте этот файл в:
#   %LOCALAPPDATA%\WarehouseAgent\secrets\syncserver.env
# затем заполните значения и выполните scripts\protect_secrets.ps1.
#
# НИКОГДА не коммитьте заполненный файл в git и не вставляйте токены в чат.

# Базовый URL SyncServer (без завершающего слэша), напр.:
#   https://sync.example.com
#   http://192.168.10.20:8000        (допустимо только с ALLOW_INSECURE_LOCAL=true)
SYNC_SERVER_BASE_URL=

# X-User-Token агента (UUID, пользователь chief_storekeeper: warehouse_agent_comp2)
SYNC_SERVER_USER_TOKEN=

# X-Device-Token рабочего места (UUID, опционально — для аудита)
SYNC_SERVER_DEVICE_TOKEN=

# Площадка по умолчанию для остатков (целое число, опционально)
SYNC_SERVER_SITE_ID=

# Разрешить HTTP без TLS ТОЛЬКО для localhost/частных сетей (true/false, по умолчанию false)
SYNC_SERVER_ALLOW_INSECURE_LOCAL=false

# Режим доступа к каталогу:
#   chief_guarded — создание/изменение с подтверждением (MVP)
#   read_only      — только чтение (по умолчанию)
CATALOG_ACCESS_MODE=chief_guarded

# Обязательное подтверждение пользователя перед catalog create
CATALOG_CREATE_REQUIRE_CONFIRMATION=true

# Merge каталога агентом — ВСЕГДА запрещён (true игнорируется с ошибкой)
CATALOG_MERGE_ENABLED=false
